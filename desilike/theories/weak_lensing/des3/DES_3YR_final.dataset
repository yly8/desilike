#Converted from 1Yr data at https://des.ncsa.illinois.edu/releases/y1a1/key-products

measurements_format = DES
kmax = 100
intrinsic_alignment_model = DES1YR
data_types = xip xim gammat wtheta
used_data_types = xip xim gammat wtheta
num_z_bins = 4
num_gal_bins = 6
num_theta_bins = 20
theta_bins_file = DES_3YR_final_theta_bins.dat
cov_file = DES_3YR_final_cov.dat
measurements[xip] = DES_3YR_final_xip.dat
measurements[xim] = DES_3YR_final_xim.dat
measurements[gammat] = DES_3YR_final_gammat.dat
measurements[wtheta] = DES_3YR_final_wtheta.dat
nz_file = DES_3YR_final_nz_source.dat
nz_gal_file = DES_3YR_final_nz_lens.dat

#shear-ratio file
sr_file = 2pt_NG_final_2ptunblind_02_26_21_wnz_maglim_covupdate_sr.pkl

# MGCAMB MOD START: introducing the DES data cuts
#data_selection = DES_3YR_final_aggressive_cut.dat
data_selection = DES_3YR_final_standard_cut.dat
#data_selection = DES_3YR_final_soft_cut.dat
#data_selection = DES_1YR_final_selection.dat
# MGCAMB MOD END

nuisance_params = DES.paramnames
